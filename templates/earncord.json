            {
              "header": "Match",
              "content": "We match survey inventory to your profile and quality score."
            },
            {
              "header": "Verify",
              "content": "Partner postbacks confirm completes before balance credits."
            },
            {
              "header": "Payout",
              "content": "Withdraw USDT to a wallet you control — never share seed phrases."
            }
          ]
        }
