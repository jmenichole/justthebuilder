        "message": {
          "title": "Start here — link your Discord",
          "body": "EarnCord rewards start on the website, then continue in this server.",
          "sections": [
            {
              "header": "1. Create your account",
              "content": "Open https://jmenichole.github.io/earncord/index.html#login — accept Privacy, Terms, and 18+, then Continue with Discord."
            },
            {
              "header": "2. Link in Discord",
              "content": "Come back here and run /start in #bot-commands (or this channel). That saves your profile and applies your tier role."
            },
            {
              "header": "3. Earn",
              "bullets": [
                "Browse #surveys",
                "Check your score with /score",
                "Withdraw USDT when your balance is ready"
              ]
