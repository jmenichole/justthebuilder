# ============================================================
# JustTheBuilder — Environment Variables
# Copy this file to .env in the project root and fill in values
# ============================================================

# --- Discord ---
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here

# Your Discord user ID — required for /grant and /announce (owner-only; user-install commands)
# BOT_OWNER_ID=your_discord_user_id
BOT_OWNER_ID=your_discord_user_id_here

# --- AI (Groq — free at https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=mixtral-8x7b-32768

# --- Ko-fi payments (optional — alternative to Discord SKU) ---
# Shop: https://ko-fi.com/s/2c6f47f1fc
# Webhook URL: https://justthebuilder.fly.dev/webhooks/kofi
# Thank-you page (link in Ko-fi shop message): https://justthebuilder.fly.dev/kofi/thanks
# Verification token from https://ko-fi.com/manage/webhooks → Advanced
KOFI_VERIFICATION_TOKEN=your_kofi_webhook_verification_token
# API key (KF_API_...) from Ko-fi Settings → API — for shop list/create, transactions, catalog sync
# KOFI_API_KEY=KF_API_your_key_here
# Aliases: KOFI_ACCESS_TOKEN, KO_FI_ACCESS_TOKEN
# KOFI_API_BASE_URL=https://ko-fi.com/api/v1
# PUBLIC_BASE_URL=https://justthebuilder.fly.dev
# KOFI_SHOP_URL=https://ko-fi.com/s/2c6f47f1fc
# Optional: restrict to one shop item direct_link_code (leave unset to accept all shop orders)
# KOFI_SHOP_ITEM_CODE=
# Creator Pack ($2.99, 3 credits) — set direct_link_code when listed as separate Ko-fi item
# KOFI_CREATOR_SHOP_ITEM_CODE=
# KOFI_CREATOR_SHOP_URL=https://ko-fi.com/s/your-creator-pack-link

# KOFI_CREATOR_SHOP_URL=https://ko-fi.com/s/your-creator-pack-link

# --- JustTheHelper companion upsell (optional) ---
# Shown at the end of setup completion DMs. Get client ID from JustTheHelper Discord app portal.
# JUSTTHEHELPER_CLIENT_ID=1525974622875422831
# Or paste a full OAuth invite URL (overrides CLIENT_ID):
# JUSTTHEHELPER_INVITE_URL=https://discord.com/oauth2/authorize?client_id=...&scope=bot%20applications.commands
# Set to 0/false to disable the upsell:
# JUSTTHEHELPER_UPSELL=1

# --- Discord Monetization SKU IDs ---
# Basic Build Pack ($0.99 consumable) — unlocks full polish (roles/embeds/pins/tickets) once
PREMIUM_SKU_ID=1444371617319882863
# DEPRECATED — Pro Builder retired from product; safe to leave unset
# SUBSCRIPTION_SKU_ID=

# Owner commands (/grant, /announce) use Discord "User Install" — they only show on YOUR account
# after you install JustTheBuilder to your user: Developer Portal → your app → Install Count →
# "Install to my account", or the app's profile → Add to My Apps. Set BOT_OWNER_ID to your user ID.

# --- Support Server ---
# Set this after building your support server with the bot
# SUPPORT_SERVER_INVITE=https://discord.gg/NEePze3rZd
# Guild ID of your support server — bot posts all usage logs to #staff-logs there
# SUPPORT_GUILD_ID=your_support_server_id
# Optional: exact channel ID instead of auto-finding #staff-logs
# STAFF_LOG_CHANNEL_ID=

# --- Optional ---
NODE_ENV=production
# DEBUG=1

# Bot ops channels (shared bot-test guild) — same IDs for all bots
OPS_GUILD_ID=1358552411718942913
OPS_ERROR_CHANNEL_ID=1525336364403658823
OPS_ANALYTICS_CHANNEL_ID=1525336362323279955
OPS_SUPPORT_CHANNEL_ID=1525863334845612136
OPS_ALERT_USER_ID=1153034319271559328
ALERTS_BOT_ID=justthebuilder
